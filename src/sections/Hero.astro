---
import { Icon } from "astro-icon";
---

<div
  id="home"
  class="flex flex-col items-center justify-center w-full gap-4 overflow-hidden my-10 md:gap-6 md:flex-row"
>
  <div class="duration-1000 delay-150 animate-in fade-in fill-mode-both">
    <div class="avatar">
      <div
        class="w-32 sm:w-36 md:w-40 rounded-full brightness-[1.1] saturate-[1.1] avatar-border"
      >
        <img
          src="/assets/lupita-selfie.png"
          alt="Nico Avila - Selfie with Lupita"
          width="160"
          height="160"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          style={{
            objectPosition: "60% 0%",
            objectFit: "cover",
            scale: "1.15",
          }}
        />
      </div>
    </div>
  </div>

  <div
    class="text-lg flex flex-col gap-[4px] md:gap-[2px] text-shadow self-start sm:self-auto md:ml-10 md:w-auto md:max-w-[53rem] mx-auto md:mx-0 px-[2rem]"
  >
    <p
      class="slide-text animDuration-[1000] m-0 mb-2 self-start text-sm text-primary-body p-1 px-[16px] bg-[#21227642] backdrop-blur-sm border-2 border-transparent rounded-badge"
    >
      Open to GTM engineer and solutions consultant roles
    </p>
    <h1
      class="slide-text animDuration-[1000] animDelay-[150] m-0 text-primary-light text-3xl"
    >
      I build the systems that find, score, and route revenue.
    </h1>
    <p
      class="slide-text animDuration-[1000] animDelay-[300] m-0 text-primary-light text-base"
    >
      Juan "Nico" Avila — Mexico City
    </p>
    <p
      class="slide-text animDuration-[1000] animDelay-[450] m-0 mt-2 text-primary-body text-base"
    >
      GTM engineer. I'm drawn to the problems where the process is fragmented and the system doesn't exist yet — outbound, lead enrichment, ICP scoring, CRM automation. 
      US direct sales on one side, data and automation on the other.
    </p>
    <div class="flex gap-2 my-3 items-center flex-wrap">
      <a
        class="slide-icon animDelay-[600] animDuration-[500]"
        href="https://github.com/nicopxm"
        target="_blank"
        aria-label="Follow Nico on GitHub"
        rel="noopener noreferrer"
      >
        <Icon color="#e8f4f8" size={"32px"} pack="mdi" name="github" />
      </a>
      <a
        class="slide-icon animDelay-[750] animDuration-[500]"
        href="https://www.linkedin.com/in/javila95/"
        target="_blank"
        aria-label="Connect with Nico on LinkedIn"
        rel="noopener noreferrer"
      >
        <Icon color="#e8f4f8" size={"32px"} pack="mdi" name="linkedin" />
      </a>
      <a
        class="slide-icon animDelay-[900] animDuration-[500] [&>span]:shadow-md text-primary-light"
        href="mailto:nicopxm@outlook.com"
        aria-label="Email Nico"
      >
        <Icon color="#e8f4f8" size={"32px"} pack="mdi" name="email" />
      </a>
      <a
        class="slide-icon animDelay-[1050] animDuration-[500] text-sm text-primary-light p-1 px-[16px] bg-[#21227642] backdrop-blur-sm border-transparent ease-in-out duration-200 rounded-badge border-2 resume-btn"
        href="/assets/Nico-Avila-Resume.pdf"
        target="_blank"
        aria-label="Download Nico's Resume"
      >
        Résumé
      </a>
      <a
        class="slide-icon animDelay-[1200] animDuration-[500] text-sm text-primary-light p-1 px-[16px] bg-[#21227642] backdrop-blur-sm border-transparent ease-in-out duration-200 rounded-badge border-2 resume-btn"
        href="https://calendly.com/juan-avila619/intro-call"
        target="_blank"
        rel="noopener"
        aria-label="Book 20 minutes with Nico"
      >
        Book 20 minutes
      </a>
    </div>
  </div>
</div>

<style>
  .resume-btn {
    transition: color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .resume-btn:hover {
    color: #e5e7eb;
    text-shadow: 0 0 8px #9ca3af, 0 0 20px rgba(156, 163, 175, 0.8), 0 0 40px rgba(156, 163, 175, 0.4);
    border-color: #6b7280;
    box-shadow: 0 0 8px #6b7280, 0 0 20px rgba(107, 114, 128, 0.4);
    transform: scale(1.05);
  }
</style>
