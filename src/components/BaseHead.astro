---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import Scripts from "./Scripts.astro";

export interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = "/placeholder-social.jpg" } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/x-icon" href="/favicon.ico?v=1.1" />
<meta name="generator" content={Astro.generator} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<link
  rel="preload"
  as="style"
  onload="this.onload=null;this.rel='stylesheet'"
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@48,400,0,0&display=swap"
/>
<noscript>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@48,400,0,0&display=swap"
  />
</noscript>

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content="Nico Avila, Data Analyst, Scrum Master, PSM I, Project Management, Python, SQL, Tableau, ETL Pipelines, Data Visualization, Data Science, Agile Methodologies, Predictive Modeling" />
<meta name="author" content="Nico Avila" />
<link rel="canonical" href={Astro.url} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Nico Avila",
  "url": "https://nicopxm.me",
  "jobTitle": "Data Analyst & Scrum Master",
  "description": "Data Analyst with three years of experience specializing in transforming chaotic datasets into clear, actionable intelligence, engineering ETL pipelines, and utilizing Agile frameworks to align teams.",
  "knowsAbout": [
    "Data Analysis", "Project Management", "Scrum", "Python", "SQL", "Tableau", "ETL Pipelines", "Data Visualization", "Agile", "Machine Learning"
  ]
}
</script>

<Scripts />