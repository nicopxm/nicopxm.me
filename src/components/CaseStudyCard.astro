---
import type { Project } from "../types";
import type { ImageMetadata } from "astro";
import Tag from "./Tag.astro";
import { Image } from "astro:assets";

const { project, priority = false } = Astro.props as {
  project: Project;
  priority?: boolean;
};
const {
  filename,
  name,
  client,
  tags,
  link,
  imageStyle,
  postID,
  problem,
  system,
  outcome,
  status,
  metrics,
} = project as Project;

const statusLabel: Record<string, string> = {
  live: "Live",
  "in-progress": "In progress",
  shipped: "Shipped",
};

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{jpeg,jpg,png,gif,webp}"
);

const imageLoader = filename ? images[`/src/assets/${filename}`] : undefined;
---

<style>
  .card {
    width: 300px;
    background: transparent;
  }
</style>
<style is:global>
  .card:hover {
    box-shadow: 1px 1px 10px #e4bef5;
  }
</style>

<a
  href={postID ? `/work/${postID}` : link}
  target={postID ? undefined : "_blank"}
  class="flex flex-col rounded-[12px] hover:scale-[103%] card group duration-300 ease-in-out min-w-[16rem] bg-base-100 shadow-md flex-none cursor-pointer overflow-hidden"
>
  <figure>
    {
      imageLoader ? (
        <Image
          src={imageLoader()}
          alt={name || ""}
          loading={priority ? "eager" : "lazy"}
          width={300}
          height={225}
          style={{
            aspectRatio: "4/3",
            objectPosition: "50% 20%",
            objectFit: "cover",
            width: "100%",
            ...imageStyle,
          }}
          transition:name={postID ? `project-${postID}` : undefined}
        />
      ) : (
        <div
          class="w-full flex items-center justify-center bg-slate-800 px-4 text-center"
          style={{ aspectRatio: "4/3" }}
          transition:name={postID ? `project-${postID}` : undefined}
        >
          <span class="text-card-title font-bold">{name}</span>
        </div>
      )
    }
  </figure>
  <div class="p-4 pb-2 flex flex-col flex-grow gap-2 bg-slate-800 filter:blur-md">
    {
      name ? (
        <h2 class="card-title inline-block text-card-title font-bold">
          {name}
        </h2>
      ) : (
        <div class="h-0" />
      )
    }

    {client && <span class="text-accent-cyan">{client}</span>}

    {problem && <span class="text-gray-400 text-sm line-clamp-2">{problem}</span>}
    {system && <span class="text-primary-body text-sm line-clamp-2">{system}</span>}
    {outcome && <span class="text-accent-cyan text-sm line-clamp-2">{outcome}</span>}

    {
      metrics && metrics.length > 0 && (
        <div class="flex flex-wrap gap-x-6 gap-y-2 pt-1">
          {metrics.map((metric) => (
            <div class="flex flex-col">
              <span class="text-accent-cyan font-bold">{metric.value}</span>
              <span class="text-gray-400 text-xs">{metric.label}</span>
            </div>
          ))}
        </div>
      )
    }

    {
      status && (
        <span class="text-xs text-accent-green border border-current rounded-badge px-2 py-[1px] self-start">
          {statusLabel[status] ?? status}
        </span>
      )
    }
    <div class="card-actions mt-auto pt-2">
      <div class="flex flex-wrap gap-[10px] gap-y-0">
        {tags?.map((tag: string) => <Tag title={tag} />)}
      </div>
    </div>
  </div>
</a>
