---
import { SITE_TITLE } from "../config";
import nav from "../data/nav";
---

<style>
  .side-drawer {
    position: fixed;
    margin-top: 20px;
    z-index: 1;
    right: 0px;
    transform: translateX(100%);

    transition: transform 0.25s ease-in-out;
  }

  .drawer-toggle:checked ~ .side-drawer {
    transform: translateX(-10px);
  }

  .site-title-glow {
    border: 1px solid #6b7280;
    box-shadow: 0 0 8px #6b7280, 0 0 20px rgba(107, 114, 128, 0.4);
    padding: 4px 16px;
    border-radius: 6px;
  }

  ul {
    white-space: nowrap;
    @apply px-4 py-2;
  }

  li a {
    color: #ffffff;
    text-shadow: 2px 2px 8px #1a1a1a;
    @apply transition-transform hover:scale-110;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  li a:hover {
    color: #e5e7eb;
    text-shadow: 0 0 8px #9ca3af, 0 0 20px rgba(156, 163, 175, 0.8), 0 0 40px rgba(156, 163, 175, 0.4);
    cursor: pointer;
  }
</style>
<input id="drawer" type="checkbox" class="drawer-toggle !fixed" />

<header class="top-0 z-10 max-w-6xl m-auto">
  <div
    class="flex items-center justify-between px-4 md:pr-0 md:pl-5 min-h-16 pt-5"
  >
    <a
      href="/"
      class="text-3xl text-primary-light font-oxygen text-shadow hover:cursor-pointer site-title-glow"
    >
      {SITE_TITLE}
    </a>
    <label
      for="drawer"
      class="text-primary-light btn btn-square btn-ghost hover:bg-transparent md:hidden"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        class="inline-block w-8 h-8 stroke-current svg-shadow"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </label>
    <nav class="hidden md:block">
      <ul class="flex items-center gap-4 transition-transform">
        <!-- Navbar menu content here -->
        {
          nav.map((item) => (
            <li>
              <a
                href={item.id ? `/#${item.id}` : "/"}
                class={item.id || "home"}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<div class="side-drawer panel">
  <nav class="relative py-1 rounded-sm flex-nowrap">
    <ul class="flex flex-col gap-5 text-xs">
      {
        nav.map((item) => (
          <li>
            <a
              onclick="document.getElementById('drawer').checked = false;"
              href={item.id ? `/#${item.id}` : "/"}
              class={`${item.id || "home"} text-xl`}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
